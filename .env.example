# CinePay Paid Movie Telegram Bot - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or keys to GitHub!

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# 2. Your Telegram Numeric User ID (get it from @userinfobot or @raw_data_bot)
# Bot checks if ctx.from.id matches this for all /admin and management actions
ADMIN_TELEGRAM_ID="987654321"

# 3. Supabase Project Credentials (from Project Settings -> API)
# Use the Project URL (https://xxxx.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"
# Use the secret service_role key for server-side trusted operations
# DO NOT expose this in frontend code!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Default UPI Payment Settings (can also be updated dynamically in bot)
UPI_ID="merchant@upi"
UPI_NAME="CinePay Official"

# 5. Server Port (Render sets this automatically via process.env.PORT)
PORT=3000

# 6. Optional: Base App URL for Webhook or health checks
APP_URL="https://your-app-name.onrender.com"
